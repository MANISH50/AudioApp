<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Test names use underscores for readability. -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Spatia.Core\Spatia.Core.csproj" />
  </ItemGroup>
  <!-- The shared engine built from android/core-dsp (see windows/README.md). -->
  <PropertyGroup>
    <SpatiaNativeDir Condition="'$(SpatiaNativeDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\..\..\android\core-dsp\build\bin\mingwX64\releaseShared\</SpatiaNativeDir>
    <SpatiaNativeDir Condition="'$(SpatiaNativeDir)' == ''">$(MSBuildThisFileDirectory)../../../android/core-dsp/build/bin/linuxX64/releaseShared/</SpatiaNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SpatiaNativeDir)spatia_dsp.dll" Condition="Exists('$(SpatiaNativeDir)spatia_dsp.dll')" CopyToOutputDirectory="PreserveNewest" Link="spatia_dsp.dll" />
    <None Include="$(SpatiaNativeDir)libspatia_dsp.so" Condition="Exists('$(SpatiaNativeDir)libspatia_dsp.so')" CopyToOutputDirectory="PreserveNewest" Link="libspatia_dsp.so" />
  </ItemGroup>
</Project>

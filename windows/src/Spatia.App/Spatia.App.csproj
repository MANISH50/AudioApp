<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Spatia.App</RootNamespace>
    <AssemblyName>Spatia</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained desktop app: runs from a folder, no Store or installer needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Required even when unpackaged: generates Spatia.pri, which merges the framework's default control styles
         (without it WinUI fails fast in GetDefaultStyleByTypeName as soon as a control is shown). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\Spatia.ico</ApplicationIcon>
    <!-- Only App.xaml and MainWindow.xaml live here (standard WinUI startup); all pages are in Spatia.UI. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spatia.Core\Spatia.Core.csproj" />
    <ProjectReference Include="..\Spatia.Audio\Spatia.Audio.csproj" />
    <ProjectReference Include="..\Spatia.UI\Spatia.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\Spatia.ico" Link="Spatia.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The shared engine (android/core-dsp, Kotlin/Native mingwX64). CI passes SpatiaNativeDir. -->
  <PropertyGroup>
    <SpatiaNativeDir Condition="'$(SpatiaNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\android\core-dsp\build\bin\mingwX64\releaseShared\</SpatiaNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(SpatiaNativeDir)spatia_dsp.dll" Condition="Exists('$(SpatiaNativeDir)spatia_dsp.dll')" Link="spatia_dsp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

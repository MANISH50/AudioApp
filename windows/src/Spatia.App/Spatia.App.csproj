<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Spatia.App</RootNamespace>
    <AssemblyName>Spatia</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained desktop app: runs from a folder, no Store or installer needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The UI is built in C# (no XAML files), so it compiles and is checked on any OS. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spatia.Core\Spatia.Core.csproj" />
    <ProjectReference Include="..\Spatia.Audio\Spatia.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- One line per language: Strings\<culture>\Resources.resw -->
    <EmbeddedResource Include="Strings\en-US\Resources.resw" LogicalName="Strings.en-US.Resources.resw" />
  </ItemGroup>
  <!-- The shared engine (android/core-dsp, Kotlin/Native mingwX64). CI passes SpatiaNativeDir. -->
  <PropertyGroup>
    <SpatiaNativeDir Condition="'$(SpatiaNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\android\core-dsp\build\bin\mingwX64\releaseShared\</SpatiaNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(SpatiaNativeDir)spatia_dsp.dll" Condition="Exists('$(SpatiaNativeDir)spatia_dsp.dll')" Link="spatia_dsp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

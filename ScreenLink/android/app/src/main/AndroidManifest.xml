<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Minimal permissions, each one needed (see ScreenLink/SECURITY.md). -->
    <!-- Local network connection to the laptop (TLS) and the discovery broadcast. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reads the Wi-Fi network's address range to send the discovery broadcast to it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Screen capture runs in a foreground service of type mediaProjection (Android 14+ rules). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Shows the "ScreenLink is casting" notification with its Stop button. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Defensive: make sure no library merges these in. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <application
        android:name=".ScreenLinkApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenLink"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".cast.ScreenCastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Lets the paired laptop tap, swipe and type on this phone while casting. Off until the user enables it in
             Settings > Accessibility AND switches on "Let the laptop control this phone" in ScreenLink.
             Exported only to the system (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".control.ControlService"
            android:exported="true"
            android:label="@string/control_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_service" />
        </service>
    </application>
</manifest>

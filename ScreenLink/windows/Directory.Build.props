<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- All .NET security rules (CA2xxx/CA3xxx/CA5xxx) enabled; with TreatWarningsAsErrors they fail the build. -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Pinned, locked dependency graph (packages.lock.json); CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Version>0.2.0</Version>
    <Company>ScreenLink</Company>
    <Product>ScreenLink</Product>
    <!-- Lets the Windows-specific libraries compile on Linux CI as well. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ScreenLink.App</RootNamespace>
    <AssemblyName>ScreenLink</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained desktop app: runs from a folder, no Store needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Required even when unpackaged: generates ScreenLink.pri with the framework's default control styles. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\ScreenLink.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenLink.Core\ScreenLink.Core.csproj" />
    <ProjectReference Include="..\ScreenLink.UI\ScreenLink.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\ScreenLink.ico" Link="ScreenLink.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
